# Node.js 24+; run npm run dev or npm start.
PORT=3000
ADMIN_PASSWORD=
INDEXABLE=false
SITE_URL=http://localhost:3000
# Persistent local disk (required; not an ephemeral/serverless filesystem).
DATA_DIR=./data
# Enable only behind a trusted proxy that replaces x-forwarded-for.
TRUST_PROXY=false

# Search Console verification code, supplied after domain registration.
GOOGLE_SITE_VERIFICATION=
