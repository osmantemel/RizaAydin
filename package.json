{
  "name": "riza-aydin-dekorasyon",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "test": "node --env-file-if-exists=.env --test test/*.test.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "format": "prettier --write app components server lib content styles scripts test next.config.mjs package.json",
    "format:check": "prettier --check app components server lib content styles scripts test next.config.mjs package.json",
    "build:preview": "node scripts/export-preview.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
